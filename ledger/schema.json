{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildwhatmovesindia.example/schemas/bescom-ledger-v1.json",
  "title": "BESCOM transfer evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "agencies", "scenarios", "sources", "claims", "nodes", "edges", "roadblocks", "journeys"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "agencies": { "type": "array", "items": { "$ref": "#/$defs/agency" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "roadblocks": { "type": "array", "items": { "$ref": "#/$defs/roadblock" } },
    "journeys": { "type": "array", "items": { "$ref": "#/$defs/journey" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$" },
    "date": { "type": "string", "format": "date" },
    "recordStatus": { "enum": ["verified", "partial", "contested", "unknown"] },
    "refList": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "nonEmptyRefList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "title", "jurisdiction", "asOf", "dataKind", "disclaimer"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "title": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "asOf": { "$ref": "#/$defs/date" },
        "dataKind": { "enum": ["synthetic", "template", "research"] },
        "disclaimer": { "type": "string", "minLength": 1 }
      }
    },
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "shortName", "officialUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "officialUrl": { "type": "string", "format": "uri" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "summary", "tags", "pathNodeIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "pathNodeIds": { "$ref": "#/$defs/refList" },
        "status": { "$ref": "#/$defs/recordStatus" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "accessedAt", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "accessedAt": { "$ref": "#/$defs/date" },
        "publishedAt": { "$ref": "#/$defs/date" },
        "type": { "enum": ["law", "regulation", "order", "official_guidance", "official_form", "official_portal", "secondary", "citizen_evidence", "firsthand_observation"] },
        "notes": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "jurisdiction", "scenarioIds", "nodeIds", "sourceIds", "evidenceGrade", "basis", "status", "contradictsClaimIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string", "minLength": 1 },
        "scenarioIds": { "$ref": "#/$defs/nonEmptyRefList" },
        "nodeIds": { "$ref": "#/$defs/refList" },
        "sourceIds": { "$ref": "#/$defs/refList" },
        "evidenceGrade": { "enum": ["A", "B", "C", "D", "E", "F", "Unknown"] },
        "basis": { "enum": ["observation", "inference", "mixed"] },
        "status": { "$ref": "#/$defs/recordStatus" },
        "contradictsClaimIds": { "$ref": "#/$defs/refList" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "evidenceGrade": { "not": { "const": "Unknown" } } }, "required": ["evidenceGrade"] },
          "then": { "properties": { "sourceIds": { "minItems": 1 } } }
        }
      ]
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "claimIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "actualError": { "type": "string" },
        "claimIds": { "$ref": "#/$defs/refList" },
        "status": { "$ref": "#/$defs/recordStatus" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "summary", "requiredState", "checks", "failureSignals", "recoveries", "scenarioIds", "claimIds", "status", "displayOrder"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["document", "record", "service", "decision", "system", "outcome"] },
        "ownerAgencyId": { "$ref": "#/$defs/id" },
        "summary": { "type": "string", "minLength": 1 },
        "requiredState": { "type": "string", "minLength": 1 },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/detail" } },
        "failureSignals": { "type": "array", "items": { "$ref": "#/$defs/detail" } },
        "recoveries": { "type": "array", "items": { "$ref": "#/$defs/detail" } },
        "researchedNoSourceFound": {
          "type": "array",
          "description": "Empty node-detail fields that were searched in this research pass and had no public source. An omitted field is not yet researched.",
          "uniqueItems": true,
          "items": { "enum": ["checks", "failureSignals", "recoveries"] }
        },
        "scenarioIds": { "$ref": "#/$defs/refList" },
        "claimIds": { "$ref": "#/$defs/refList" },
        "status": { "$ref": "#/$defs/recordStatus" },
        "displayOrder": { "type": "integer", "minimum": 0 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromNodeId", "toNodeId", "relationship", "label", "scenarioIds", "claimIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "fromNodeId": { "$ref": "#/$defs/id" },
        "toNodeId": { "$ref": "#/$defs/id" },
        "relationship": { "enum": ["requires", "produces", "maps_to", "blocks", "alternative"] },
        "label": { "type": "string", "minLength": 1 },
        "scenarioIds": { "$ref": "#/$defs/refList" },
        "claimIds": { "$ref": "#/$defs/refList" },
        "status": { "$ref": "#/$defs/recordStatus" }
      }
    },
    "roadblock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "symptom", "likelyCause", "recovery", "nodeIds", "scenarioIds", "claimIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "enum": ["documentation", "process", "infrastructure"] },
        "symptom": { "type": "string", "minLength": 1 },
        "likelyCause": { "type": "string", "minLength": 1 },
        "recovery": { "type": "string", "minLength": 1 },
        "ownerAgencyIds": { "$ref": "#/$defs/refList" },
        "nodeIds": { "$ref": "#/$defs/nonEmptyRefList" },
        "scenarioIds": { "$ref": "#/$defs/nonEmptyRefList" },
        "claimIds": { "$ref": "#/$defs/refList" },
        "status": { "$ref": "#/$defs/recordStatus" }
      }
    },
    "journeyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "nodeId", "action", "expectedResult", "claimIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "nodeId": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "minLength": 1 },
        "expectedResult": { "type": "string", "minLength": 1 },
        "claimIds": { "$ref": "#/$defs/refList" },
        "status": { "$ref": "#/$defs/recordStatus" }
      }
    },
    "journeyDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromNodeId", "toNodeId", "description", "claimIds", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "fromNodeId": { "$ref": "#/$defs/id" },
        "toNodeId": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "claimIds": { "$ref": "#/$defs/refList" },
        "status": { "$ref": "#/$defs/recordStatus" }
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "scenarioId", "context", "steps", "dependencies", "failureRoadblockIds", "recoveryNotes", "documentationQualityNotes", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "scenarioId": { "$ref": "#/$defs/id" },
        "context": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/journeyStep" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/journeyDependency" } },
        "failureRoadblockIds": { "$ref": "#/$defs/refList" },
        "recoveryNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "documentationQualityNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "status": { "$ref": "#/$defs/recordStatus" }
      }
    }
  }
}
