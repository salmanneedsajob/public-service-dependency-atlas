{
  "name": "bescom-transfer-ledger-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:ledger": "node scripts/prepare-ledger.mjs",
    "predev": "npm run prepare:ledger",
    "dev": "next dev",
    "prebuild": "npm run prepare:ledger",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-fixture.mjs && node scripts/verify-research.mjs && node scripts/verify-service-isolation.mjs && node scripts/verify-comprehension.mjs && node scripts/verify-mode-navigation.mjs && node scripts/verify-source-groups.mjs && node scripts/verify-service-status.mjs && node scripts/verify-links.mjs",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vercel": "59.7.0",
    "yaml": "2.8.1"
  },
  "type": "module"
}
